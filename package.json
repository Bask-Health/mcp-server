{
  "name": "mcp-chatgpt-server",
  "version": "1.0.0",
  "description": "MCP Server for ChatGPT Integration with search and fetch capabilities",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "rimraf dist && tsc",
    "serve": "node dist/index.js",
    "ts.check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "sync": "tsx src/initialRepoSync.ts",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy",
    "sst:remove": "sst remove"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "openai",
    "vector-store"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@octokit/rest": "^22.0.0",
    "@pulumi/aws": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "markdown-it": "^14.1.0",
    "mysql2": "^3.15.2",
    "openai": "^4.56.0",
    "rimraf": "^6.0.1",
    "sst": "3.17.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
